# Owner-only dashboard access
OWNER_EMAIL=owner@example.com

# Live outbound delivery remains blocked unless all three values are set.
RESEND_API_KEY=
DELIVERY_FROM_EMAIL=briefs@example.com
LIVE_DELIVERY=0

# Optional hosted checkout and webhook configuration.
PAYMENTS_MODE=disabled
LEMON_SQUEEZY_CHECKOUT_URL=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Optional owner-dashboard report synchronization.
REPORT_SYNC_URL=
REPORT_SYNC_SECRET=

# The included deterministic engine runs without an AI key and never performs
# live research by itself.
RESEARCH_PROVIDER=fixture
